# Ultra-lightweight CPU-only version with optimized layers
FROM python:3.11-slim AS dependencies

# Set noninteractive mode for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies in a single layer
RUN apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends \
    ffmpeg \
    libxcb-xfixes0 \
    libxcb-shape0 && \
    pip install --no-cache-dir uv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Set working directory
WORKDIR /app

# Configure uv to use a consistent virtual environment location
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy dependency files first for better layer caching
COPY requirements.txt pyproject.toml ./

# Install Python dependencies and create persistent virtual environment
RUN uv sync --no-dev && \
    uv add funasr modelscope huggingface_hub pywhispercpp torch torchaudio edge-tts azure-cognitiveservices-speech py3-tts && \
    # 캐시는 유지하되 임시 파일만 정리
    find /tmp -type f -delete 2>/dev/null || true

# Copy only necessary application files (excluding build artifacts, cache, etc.)
COPY . .

# Copy and set up entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create necessary directories and ensure virtual environment is accessible
RUN mkdir -p logs cache chat_history && \
    chmod +x run_server.py && \
    # 가상환경 경로 확인 및 권한 설정
    ls -la /app/.venv/bin/ || true

# Expose port 12393
EXPOSE 12393

# Use non-root user for security
# RUN groupadd -r appuser && useradd -r -g appuser appuser && \
#     chown -R appuser:appuser /app
# USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:12393/health || exit 1

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default command - 이제 entrypoint가 가상환경을 활성화해줍니다
CMD ["python", "run_server.py"]